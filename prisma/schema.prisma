datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Category {
  id    String @id @default(cuid())
  name  String
  slug  String @unique
  posts Post[]
}

model Post {
  id         String    @id @default(cuid())
  title      String
  slug       String    @unique
  content    String
  image      String
  views      Int       @default(0)
  lang String @default("uk")
  createdAt  DateTime  @default(now())
  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id])
  comments   Comment[]
}

model Comment {
  id        String   @id @default(cuid())
  author    String
  text      String
  createdAt DateTime @default(now())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
}
